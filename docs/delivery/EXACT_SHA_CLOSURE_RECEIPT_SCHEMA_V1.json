{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://galvanik-kreile.local/contracts/EXACT_SHA_CLOSURE_RECEIPT_SCHEMA_V1.json",
  "title": "Kreile Exact-SHA closure receipt V1",
  "description": "External receipt for an immutable commit. It may close a reviewed candidate or a main delivery, but it may never turn branch evidence into a main or Production claim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "generated_at",
    "package_id",
    "closure_status",
    "candidate",
    "identity_checks",
    "local_gates",
    "remote_gates",
    "implementation_review",
    "findings_ledger",
    "delivery_truth",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "package_id": { "type": "string", "pattern": "^KR-" },
    "closure_status": {
      "enum": ["REVIEWED_CANDIDATE", "MAIN_DELIVERED"]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_sha",
        "candidate_sha",
        "tree_sha",
        "branch",
        "remote_ref",
        "remote_sha"
      ],
      "properties": {
        "parent_sha": { "$ref": "#/definitions/sha" },
        "candidate_sha": { "$ref": "#/definitions/sha" },
        "tree_sha": { "$ref": "#/definitions/sha" },
        "branch": { "type": "string", "minLength": 1 },
        "remote_ref": { "type": "string", "minLength": 1 },
        "remote_sha": { "$ref": "#/definitions/sha" }
      }
    },
    "identity_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_matches_manifest",
        "candidate_matches_local_head",
        "candidate_matches_remote_head",
        "tree_clean_after_push",
        "allowlist_exact"
      ],
      "properties": {
        "parent_matches_manifest": { "const": true },
        "candidate_matches_local_head": { "const": true },
        "candidate_matches_remote_head": { "const": true },
        "tree_clean_after_push": { "const": true },
        "allowlist_exact": { "const": true }
      }
    },
    "local_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/gate_receipt" }
    },
    "remote_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/gate_receipt" }
    },
    "implementation_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broad_reviews",
        "model",
        "session_id",
        "started_at",
        "ended_at",
        "exit_code",
        "result",
        "correction_rounds",
        "delta_review_session_id",
        "raw_output_sha256"
      ],
      "properties": {
        "broad_reviews": { "const": 1 },
        "model": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "exit_code": { "const": 0 },
        "result": {
          "enum": [
            "PASS_EXACT_SHA_NO_OPEN_P0_P1_P2",
            "PASS_TARGETED_DELTA_NO_OPEN_P0_P1_P2"
          ]
        },
        "correction_rounds": { "type": "integer", "minimum": 0, "maximum": 1 },
        "delta_review_session_id": { "type": ["string", "null"] },
        "raw_output_sha256": { "$ref": "#/definitions/sha256" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "correction_rounds": { "const": 0 } }
          },
          "then": {
            "properties": { "delta_review_session_id": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "correction_rounds": { "const": 1 } }
          },
          "then": {
            "properties": { "delta_review_session_id": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "findings_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "open_p0", "open_p1", "open_p2", "decision"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "open_p0": { "const": 0 },
        "open_p1": { "const": 0 },
        "open_p2": { "const": 0 },
        "decision": { "const": "FREEZE_AS_REVIEWED_CANDIDATE" }
      }
    },
    "delivery_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "main_delivered",
        "main_sha",
        "merge_sha",
        "post_merge_checks",
        "production_authorized",
        "production_effect"
      ],
      "properties": {
        "main_delivered": { "type": "boolean" },
        "main_sha": {
          "anyOf": [
            { "$ref": "#/definitions/sha" },
            { "type": "null" }
          ]
        },
        "merge_sha": {
          "anyOf": [
            { "$ref": "#/definitions/sha" },
            { "type": "null" }
          ]
        },
        "post_merge_checks": {
          "enum": ["NOT_RUN", "PASS"]
        },
        "production_authorized": { "type": "boolean" },
        "production_effect": {
          "enum": [
            "NONE_CANDIDATE_ONLY",
            "AUTOMATIC_PRODUCTION_EFFECT_SEPARATELY_AUTHORIZED_AND_VERIFIED"
          ]
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_clean", "review_process_tree_clear", "temporary_build_dirs_restored"],
      "properties": {
        "worktree_clean": { "const": true },
        "review_process_tree_clear": { "const": true },
        "temporary_build_dirs_restored": { "const": true }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "closure_status": { "const": "REVIEWED_CANDIDATE" } }
      },
      "then": {
        "properties": {
          "delivery_truth": {
            "properties": {
              "main_delivered": { "const": false },
              "main_sha": { "type": "null" },
              "merge_sha": { "type": "null" },
              "post_merge_checks": { "const": "NOT_RUN" },
              "production_authorized": { "const": false },
              "production_effect": { "const": "NONE_CANDIDATE_ONLY" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "closure_status": { "const": "MAIN_DELIVERED" } }
      },
      "then": {
        "properties": {
          "delivery_truth": {
            "properties": {
              "main_delivered": { "const": true },
              "main_sha": { "$ref": "#/definitions/sha" },
              "merge_sha": { "$ref": "#/definitions/sha" },
              "post_merge_checks": { "const": "PASS" },
              "production_authorized": { "const": true },
              "production_effect": { "const": "AUTOMATIC_PRODUCTION_EFFECT_SEPARATELY_AUTHORIZED_AND_VERIFIED" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "gate_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "candidate_sha", "started_at", "ended_at", "output_sha256"],
      "properties": {
        "gate_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["PASS", "NOT_APPLICABLE_WITH_EVIDENCE"] },
        "candidate_sha": { "$ref": "#/definitions/sha" },
        "run_id": { "type": ["string", "null"] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "output_sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}
