{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://galvanik-kreile.local/contracts/ROLLING_MANIFEST_QUEUE_SCHEMA_V1.json",
  "title": "Kreile rolling package queue policy V1",
  "description": "Closed policy for issuing exactly one package manifest at a time. Entries are non-executable pointers; live execution truth remains exclusively in the mission file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "authority",
    "execution_state_source",
    "parent_candidate",
    "effective_base_handoff",
    "issuance_policy",
    "initial_horizon",
    "next_contract_blueprint",
    "materialized_future_contracts",
    "after_initial_horizon_rule"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "const": "KREILE_ROLLING_MANIFEST_QUEUE_V1" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_path", "plan_section", "plan_sha256"],
      "properties": {
        "plan_path": { "const": "docs/project/BUILDPLAN_KREILE_BIS_LIVE_2026-09-28_FINAL.md" },
        "plan_section": { "const": "4_KR_00F_ROLLENDE_MANIFESTE" },
        "plan_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "execution_state_source": { "const": "missions/F1_ORDER_TO_CASH_PILOT_001.yml" },
    "parent_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_id",
        "candidate_sha",
        "tree_sha",
        "remote_ref",
        "review_result",
        "review_receipt",
        "review_receipt_sha256",
        "closure_receipt",
        "closure_receipt_sha256"
      ],
      "properties": {
        "package_id": { "const": "KR-04R-PR113-DEAD-UI-REMOVAL" },
        "candidate_sha": { "$ref": "#/definitions/sha" },
        "tree_sha": { "$ref": "#/definitions/sha" },
        "remote_ref": { "const": "origin/main" },
        "review_result": { "const": "PASS_EXACT_SHA_NO_OPEN_P0_P1_P2_REMOTE_GATES_GREEN_MAIN_DELIVERED_TREE_EQUIVALENT" },
        "review_receipt": { "const": "../_MODULDOSSIERS/00_PROJEKT/KR-04R_MAIN_DELIVERY_RECEIPT_2026-10-03.md" },
        "review_receipt_sha256": { "$ref": "#/definitions/sha256" },
        "closure_receipt": { "const": "../_MODULDOSSIERS/00_PROJEKT/KR-04R_MAIN_DELIVERY_RECEIPT_2026-10-03.md" },
        "closure_receipt_sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "effective_base_handoff": {
      "$ref": "#/definitions/base_handoff"
    },
    "issuance_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_materialized_contract_at_a_time",
        "max_materialized_future_contracts",
        "exact_reviewed_parent_required",
        "remote_identity_required",
        "candidate_chain_when_merge_unavailable",
        "candidate_is_not_main_delivery",
        "rebase_and_reverify_after_real_main_change",
        "halt_on_open_p0_p1_after_one_correction",
        "no_periodic_build_automation"
      ],
      "properties": {
        "one_materialized_contract_at_a_time": { "const": true },
        "max_materialized_future_contracts": { "const": 0 },
        "exact_reviewed_parent_required": { "const": true },
        "remote_identity_required": { "const": true },
        "candidate_chain_when_merge_unavailable": { "const": true },
        "candidate_is_not_main_delivery": { "const": true },
        "rebase_and_reverify_after_real_main_change": { "const": true },
        "halt_on_open_p0_p1_after_one_correction": { "const": true },
        "no_periodic_build_automation": { "const": true }
      }
    },
    "initial_horizon": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": [
        {
          "allOf": [
            { "$ref": "#/definitions/package_pointer" },
            {
              "properties": {
                "order": { "const": 1 },
                "package_id": { "const": "KR-02R-B1-P0-CANCEL" },
                "scope": { "const": "B1" },
                "predecessor": { "const": "KR-22R-DESKTOP-READ-RECOVERY" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/package_pointer" },
            {
              "properties": {
                "order": { "const": 2 },
                "package_id": { "const": "KR-03A-DELIVERY-ADHERENCE-DOMAIN" },
                "scope": { "const": "B2A" },
                "predecessor": { "const": "KR-02R-B1-P0-CANCEL" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/definitions/package_pointer" },
            {
              "properties": {
                "order": { "const": 3 },
                "package_id": { "const": "KR-03B1-FINAL-DB-READ-CONTRACT" },
                "scope": { "const": "B2B1" },
                "predecessor": { "const": "KR-03A-DELIVERY-ADHERENCE-DOMAIN" }
              }
            }
          ]
        }
      ],
      "additionalItems": false
    },
    "next_contract_blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "predecessor", "planned_path", "classification", "issue_when"],
      "properties": {
        "package_id": { "const": "KR-02R-B1-P0-CANCEL" },
        "predecessor": { "const": "KR-22R-DESKTOP-READ-RECOVERY" },
        "planned_path": { "const": "docs/delivery/packages/KR-02R-B1-P0-CANCEL.yaml" },
        "classification": { "const": "POINTER_ONLY_NON_EXECUTABLE_UNTIL_ISSUED" },
        "issue_when": { "const": "KR_22R_REMOTE_EXACT_SHA_REVIEWED_AND_CLOSED" }
      }
    },
    "materialized_future_contracts": {
      "type": "array",
      "maxItems": 0
    },
    "after_initial_horizon_rule": {
      "const": "ISSUE_ONLY_THE_NEXT_DEPENDENT_PACKAGE_FROM_THE_AUTHORITY_PLAN_AFTER_PREDECESSOR_CLOSURE"
    }
  },
  "definitions": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9A-F]{64}$" },
    "base_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_parent_sha", "effective_base_sha", "effective_base_tree_sha", "entries"],
      "properties": {
        "queue_parent_sha": { "$ref": "#/definitions/sha" },
        "effective_base_sha": { "$ref": "#/definitions/sha" },
        "effective_base_tree_sha": { "$ref": "#/definitions/sha" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pr",
              "parent_sha",
              "candidate_sha",
              "merge_sha",
              "tree_sha",
              "scope",
              "review_result",
              "post_main_agentur_gate_run",
              "post_main_quality_run",
              "vercel_status"
            ],
            "properties": {
              "pr": { "type": "integer", "minimum": 1 },
              "parent_sha": { "$ref": "#/definitions/sha" },
              "candidate_sha": { "$ref": "#/definitions/sha" },
              "merge_sha": { "$ref": "#/definitions/sha" },
              "tree_sha": { "$ref": "#/definitions/sha" },
              "scope": { "const": "PROTECTED_CI_GOVERNANCE_ONLY" },
              "review_result": { "type": "string", "pattern": "^PASS" },
              "post_main_agentur_gate_run": { "type": "integer", "minimum": 1 },
              "post_main_quality_run": { "type": "integer", "minimum": 1 },
              "vercel_status": { "const": "SUCCESS" }
            }
          }
        }
      }
    },
    "package_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "package_id", "scope", "predecessor", "classification", "issue_when"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "package_id": { "type": "string", "pattern": "^KR-" },
        "scope": { "enum": ["GOVERNANCE", "PRODUCT_CLEANUP", "B1", "B2A", "B2B1"] },
        "predecessor": { "type": "string", "pattern": "^KR-" },
        "classification": { "const": "ORDER_POINTER_NOT_AN_EXECUTABLE_MANIFEST" },
        "issue_when": { "const": "PREDECESSOR_REMOTE_EXACT_SHA_REVIEWED_AND_CLOSED" }
      }
    }
  }
}
