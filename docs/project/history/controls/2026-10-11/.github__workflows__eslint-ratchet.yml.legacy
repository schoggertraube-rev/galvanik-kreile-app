name: ESLint Ratchet

on:
  pull_request_target:
    branches:
      - main
    types: [opened, synchronize, reopened, ready_for_review]

permissions:
  contents: read

jobs:
  ratchet:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout protected base
        uses: actions/checkout@v5
        with:
          ref: ${{ github.event.pull_request.base.sha }}
          path: ratchet-base
          fetch-depth: 0
          persist-credentials: false

      - name: Checkout candidate without credentials
        uses: actions/checkout@v5
        with:
          repository: ${{ github.event.pull_request.head.repo.full_name }}
          ref: ${{ github.event.pull_request.head.sha }}
          path: candidate
          fetch-depth: 0
          persist-credentials: false

      - name: Determine protected Node version
        id: node-version
        working-directory: ratchet-base
        shell: bash
        run: |
          set -euo pipefail
          node_version="$(node -e "const fs=require('fs'); const pkg=JSON.parse(fs.readFileSync('package.json','utf8')); process.stdout.write(pkg.engines?.node ?? '')")"
          if [ -z "$node_version" ]; then
            node_version="24"
          fi
          echo "version=$node_version" >> "$GITHUB_OUTPUT"

      - name: Setup protected Node
        uses: actions/setup-node@v4
        with:
          node-version: ${{ steps.node-version.outputs.version }}
          cache: npm
          cache-dependency-path: ratchet-base/package-lock.json

      - name: Install protected lint dependencies
        working-directory: ratchet-base
        run: npm ci --ignore-scripts

      - name: Enforce protected repository ratchet
        working-directory: ratchet-base
        run: |
          test ! -e "$GITHUB_WORKSPACE/candidate/node_modules"
          ln -s "$GITHUB_WORKSPACE/ratchet-base/node_modules" "$GITHUB_WORKSPACE/candidate/node_modules"
          node --import tsx scripts/quality/check-eslint-ratchet.ts \
            --root "$GITHUB_WORKSPACE/candidate" \
            --config "$GITHUB_WORKSPACE/ratchet-base/eslint.config.mjs" \
            --base-baseline "$GITHUB_WORKSPACE/ratchet-base/quality/eslint-baseline.json"

      - name: Enforce D-GOV-001 authority contract on candidate
        working-directory: ratchet-base
        env:
          AUTHORITY_CHECKER_SHA256_OLD: "05d07eeb62e61049ccb1bbcd33b1742a9e53b56c5401bf7b0a3600e4399e80fb"
          AUTHORITY_CHECKER_SHA256_NEW: "0800b45c4f51f72f5971611c321494470ccff93037f7a02c16dc88f73b6e6ab4"
          AUTHORITY_SCHEMA_SHA256: "322018e732ee86ecdd4a0320255b8bd216d7d2281302dff8b149dfbd3a80dbba"
        run: |
          set -euo pipefail
          # KR-GOV-R3A temporarily preauthorizes exactly the protected OLD checker and
          # reviewed NEW successor checker. R3B closes this list to NEW immediately.
          checker="$GITHUB_WORKSPACE/candidate/scripts/quality/check-authoritative-sources.mjs"
          schema="$GITHUB_WORKSPACE/candidate/quality/authoritative-sources.json"
          checker_sha="$(sha256sum "$checker" | cut -d' ' -f1)"
          schema_sha="$(sha256sum "$schema" | cut -d' ' -f1)"
          if [[ "$checker_sha" != "$AUTHORITY_CHECKER_SHA256_OLD" && "$checker_sha" != "$AUTHORITY_CHECKER_SHA256_NEW" ]]; then
            echo "Authority checker hash mismatch: $checker_sha" >&2
            exit 1
          fi
          if [[ "$schema_sha" != "$AUTHORITY_SCHEMA_SHA256" ]]; then
            echo "Authority schema hash mismatch: $schema_sha" >&2
            exit 1
          fi
          node "$checker" --selftest
          node "$checker" \
            --root "$GITHUB_WORKSPACE/candidate" --check

      - name: Enforce protected S1 module gates (Path 1 Naehte)
        # Base-Skript gegen den Kandidatenbaum; die UI-Vertrag-Baseline des Kandidaten darf
        # gegenueber der Basis nur schrumpfen. Ein Kandidat kann das Gate nicht durch
        # Aendern des Skripts oder der Baseline umgehen.
        working-directory: ratchet-base
        run: |
          node scripts/quality/check-module-gates.mjs \
            --root "$GITHUB_WORKSPACE/candidate" \
            --base-baseline "$GITHUB_WORKSPACE/ratchet-base/quality/module-gates-baseline.json" \
            --schema "$GITHUB_WORKSPACE/ratchet-base/docs/architecture/MODULE_MANIFEST.schema.json"

      - name: Resolve frozen delivery trust anchor from protected base
        id: delivery-trust-anchor
        working-directory: ratchet-base
        env:
          PR_BASE_SHA: ${{ github.event.pull_request.base.sha }}
          PR_HEAD_SHA: ${{ github.event.pull_request.head.sha }}
        run: |
          set -euo pipefail
          # Resolver bytes come only from the protected base checkout; the
          # candidate checkout is data and never supplies executable resolver code.
          node "$GITHUB_WORKSPACE/ratchet-base/scripts/quality/resolve-delivery-trust-anchor.mjs" \
            --trusted-repo "$GITHUB_WORKSPACE/ratchet-base" \
            --candidate-repo "$GITHUB_WORKSPACE/candidate" \
            --base-sha "$PR_BASE_SHA" \
            --head-sha "$PR_HEAD_SHA" \
            --github-output "$GITHUB_OUTPUT"

      - name: Enforce protected delivery contracts and rolling queue
        working-directory: ratchet-base
        env:
          DELIVERY_REQUIRE_TRUSTED_BASE: "true"
          DELIVERY_TRUSTED_BASE_SHA: ${{ steps.delivery-trust-anchor.outputs.trusted_base_sha }}
          DELIVERY_TRUSTED_REPO: ${{ github.workspace }}/ratchet-base
        run: |
          set -euo pipefail
          # The candidate checker is accepted only when it is byte-identical to the
          # protected-base checker. There is no exception list and no successor pin.
          protected_checker="$GITHUB_WORKSPACE/ratchet-base/scripts/quality/check-delivery-contracts.mjs"
          candidate_checker="$GITHUB_WORKSPACE/candidate/scripts/quality/check-delivery-contracts.mjs"
          test -f "$candidate_checker"
          test ! -L "$candidate_checker"
          protected_sha="$(sha256sum "$protected_checker" | cut -d' ' -f1)"
          candidate_sha="$(sha256sum "$candidate_checker" | cut -d' ' -f1)"
          if [[ "$candidate_sha" != "$protected_sha" ]]; then
            echo "Delivery checker hash is not the protected-base checker: $candidate_sha" >&2
            exit 1
          fi
          isolated_dir="$(mktemp -d "$RUNNER_TEMP/kreile-delivery-checker.XXXXXX")"
          trap 'rm -rf "$isolated_dir"' EXIT
          install -m 0444 "$candidate_checker" "$isolated_dir/check-delivery-contracts.mjs"
          ln -s "$GITHUB_WORKSPACE/ratchet-base/node_modules" "$isolated_dir/node_modules"
          isolated_sha="$(sha256sum "$isolated_dir/check-delivery-contracts.mjs" | cut -d' ' -f1)"
          if [[ "$isolated_sha" != "$candidate_sha" ]]; then
            echo "Isolated delivery checker copy changed bytes: $isolated_sha" >&2
            exit 1
          fi
          node "$isolated_dir/check-delivery-contracts.mjs" --selftest --root "$GITHUB_WORKSPACE/candidate" --expect-self-sha256 "$protected_sha"
          node "$isolated_dir/check-delivery-contracts.mjs" --root "$GITHUB_WORKSPACE/candidate" --expect-self-sha256 "$protected_sha"
