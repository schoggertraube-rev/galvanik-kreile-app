# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Geschwister-Build-Ausgaben von Warmup-/Stop-Gate-Werkzeugen (.next.stopgate-bak,
# .next.green-warm, ...) sind Build-Artefakte wie /.next/ selbst: nie Repo-Inhalt.
# Ohne dieses Muster landen Webpack-Cache-Packs im Diff und loesen Quality-Gates
# (z.B. Forbidden patterns) auf kompilierten Strings statt auf Quellcode aus.
/.next.*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# playwright
/playwright-report/
/test-results/
/.playwright-cli/
/output/

# Governance: autonome Steuerungsdateien (kein Produktcode, nicht nach Vercel)
# Untracked Steuerungs-ZIP und Runtime-Ordner ausschließen
Agentur für App und Web/KREILE_COWORK_AUTONOME_IDEA_TO_LIVE_STEUERUNG/
Agentur für App und Web/KREILE_COWORK_AUTONOME_IDEA_TO_LIVE_STEUERUNG.zip

# Chat-/Agent-Artefakte (nie Repo-Inhalt) — verhindern "fremde ungetrackte Dateien"-Verwirrung
.claude/
Claude outputs/
