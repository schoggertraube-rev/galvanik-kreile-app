{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kreile static ratchet boundary policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "candidate_execution",
    "protected_trees",
    "protected_paths"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_id": {
      "const": "KREILE_STATIC_RATCHET_BOUNDARY_V1"
    },
    "candidate_execution": {
      "const": "NEVER_EXECUTE_CANDIDATE"
    },
    "protected_trees": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
