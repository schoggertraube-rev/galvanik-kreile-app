{
  "name": "next_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "demo:seed": "npx tsx -r dotenv/config scripts/seed-demo-data.ts dotenv_config_path=.env.local",
    "demo:cleanup": "npx tsx -r dotenv/config scripts/cleanup-demo-data.ts dotenv_config_path=.env.local",
    "demo:reset": "npm run demo:cleanup -- --confirm && npm run demo:seed -- --confirm",
    "start": "next start",
    "lint": "npm run lint:ratchet",
    "lint:app": "eslint --config eslint.config.mjs src/",
    "lint:edge": "eslint --config eslint.edge.config.mjs supabase/functions/",
    "lint:scripts": "eslint --config eslint.scripts.config.mjs scripts/ *.js migrate.mjs",
    "lint:all": "npm run lint:app && npm run lint:edge && npm run lint:scripts",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "lint:baseline:update": "node scripts/lint-ratchet.mjs --update",
    "lint:full": "eslint .",
    "lint:staged": "node scripts/verify-staged-files.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/test/verify.integration.test.ts",
    "test:e2e": "playwright test",
    "verify:precommit": "npx tsc --noEmit && npm run lint:staged && npm run test:unit",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@google/genai": "^2.6.0",
    "@google/generative-ai": "^0.24.1",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "@types/google.maps": "^3.64.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
